GEMINI_API_KEY=
FINSIGHT_LLM_PROVIDER=gemini
FINSIGHT_GEMINI_MODEL=gemini-3.1-flash-lite
FINSIGHT_GEMINI_THINKING_LEVEL=minimal
FINSIGHT_RETRIEVAL_MODE=lexical
FINSIGHT_MAX_NEW_TOKENS=384
FINSIGHT_K=3
FINSIGHT_PROVIDER_TIMEOUT_MS=15000
# Optional hardening. FINSIGHT_API_KEY must also be set for the Next.js server.
# FINSIGHT_API_KEY=
# FINSIGHT_TRUST_PROXY=1   # honour X-Forwarded-For (only behind your own proxy)
